generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url = env("MYSQL_DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  username String @unique
  password String
  role String
  sessions Session[]
}
model Session {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}
model Reference {
  id Int @id @default(autoincrement())
  kind String
  name String @db.Text
  data String @default("{}") @db.LongText
  version Int @default(1)
}
model Series {
  id Int @id @default(autoincrement())
  name String @db.Text
  description String @default("") @db.Text
  version Int @default(1)
  meetings Meeting[]
}
model Meeting {
  id Int @id @default(autoincrement())
  title String @db.Text
  startTime DateTime
  companyCode Int
  liveType Int
  status Int @default(1)
  releaseFlag Int @default(1)
  isNetSync Int @default(0)
  confirmed Boolean @default(false)
  recommended Boolean @default(false)
  version Int @default(1)
  data String @db.LongText
  seriesId Int?
  series Series? @relation(fields: [seriesId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clientRevision Int @default(0)
  rounds MeetingRound[]
  people Person[]
  files Upload[]
  documents Document[]
  tasks Task[]
  materials Material[]
  deliveries Delivery[]
  records Attendance[]
  failures ImportFailure[]
}
model Person {
  id Int @id @default(autoincrement())
  meetingId Int
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  name String @db.Text
  phone String
  data String @db.LongText
  version Int @default(1)
  @@unique([meetingId, phone])
}
model ImportFailure {
  id Int @id @default(autoincrement())
  meetingId Int
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  data String @db.LongText
  reason String
  createdAt DateTime @default(now())
}
model Upload {
  id String @id @default(cuid())
  meetingId Int?
  meeting Meeting? @relation(fields: [meetingId], references: [id])
  kind String
  filename String @db.Text
  path String
  mime String
  size Int
  createdAt DateTime @default(now())
  documents Document[]
}
model Document {
  id Int @id @default(autoincrement())
  meetingId Int
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  uploadId String
  upload Upload @relation(fields: [uploadId], references: [id])
  ownerPhone String
  position Int
}
model Task {
  id Int @id @default(autoincrement())
  meetingId Int
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  kind String
  status String @default("processing")
  input String @default("{}") @db.LongText
  result String @default("{}") @db.LongText
  simulateFailure Boolean @default(false)
  attempts Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Material {
  id Int @id @default(autoincrement())
  meetingId Int
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  kind String
  name String @db.Text
  url String @default("") @db.Text
  content String @default("") @db.LongText
  aiValid Boolean @default(false)
  recordStatus String @default("pending")
  simulated Boolean @default(true)
  version Int @default(1)
}
model Delivery {
  id Int @id @default(autoincrement())
  meetingId Int
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  recipients String @db.LongText
  contents String @db.LongText
  status String @default("simulated")
  createdAt DateTime @default(now())
}
model Attendance {
  id Int @id @default(autoincrement())
  meetingId Int
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  name String @db.Text
  phone String
  minutes Int
  source String @default("模拟数据")
  joinedAt DateTime
}
model Audit {
  id Int @id @default(autoincrement())
  actor String
  action String
  entity String
  entityId String
  changes String @db.LongText
  createdAt DateTime @default(now())
}

model ClientSession {
  id String @id
  phone String
  expiresAt DateTime
}
model MeetingRound {
  id Int @id @default(autoincrement())
  meetingId Int
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  number Int
  startedAt DateTime?
  endedAt DateTime?
  seats ClientSeat[]
  visits ClientVisit[]
  @@unique([meetingId, number])
}
model ClientSeat {
  id Int @id @default(autoincrement())
  roundId Int
  round MeetingRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  phone String
  name String @db.Text
  role String
  joined Boolean @default(false)
  muted Boolean @default(false)
  speaking Boolean @default(false)
  lastHeartbeat DateTime?
  @@unique([roundId, phone])
}
model ClientVisit {
  id Int @id @default(autoincrement())
  roundId Int
  round MeetingRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  phone String
  name String @db.Text
  role String
  joinedAt DateTime
  leftAt DateTime?
  @@index([roundId, phone])
}
